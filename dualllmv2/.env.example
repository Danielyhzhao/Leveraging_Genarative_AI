# ===== DeepSeek 双 LLM 对抗配置模板(本文件提交到 GitHub,.env 不提交) =====
# 复制本文件为 .env 并填入你自己的真实 Key:
#   cp .env.example .env

# LLM-1(分析者 / 考官)
LLM1_API_KEY=your_deepseek_api_key_here

# LLM-2(对抗者 / 导师)
LLM2_API_KEY=your_deepseek_api_key_here

# 运行模式: api = 调用真实 DeepSeek(双 Key);offline = 本地规则引擎(无需 Key)
DUAL_LLM_BACKEND=api

# 可选:模型
LLM1_MODEL=deepseek-chat
LLM2_MODEL=deepseek-chat
